import streamlit as st
import numpy as np
import time

# عنوان التطبيق
st.title("🌊 نظام الكشف الفوري عن التسربات النفطية البحرية")
st.sidebar.header("إعدادات النظام")

# رفع صورة قمر صناعي
uploaded_file = st.sidebar.file_uploader("رفع صورة القمر الصناعي (SAR)", type=["jpg", "png", "tif"])

if uploaded_file is not None:
    st.image(uploaded_file, caption="صورة القمر الصناعي المدخلة", use_column_width=True)
    
    if st.button("تشغيل التحليل الذكي (Live Demo)"):
        with st.spinner("جاري تحليل الصورة عبر خوارزمية YOLOv8-seg..."):
            time.sleep(1.5) # محاكاة للزمن السريع (أقل من 3 ثوانٍ)
        
        st.success("تم الاكتشاف بنجاح خلال 1.2 ثانية!")
        
        # عرض المخرجات والحسابات الرقمية
        col1, col2, col3 = st.columns(3)
        col1.metric("المساحة المقدرة", "12.4 km²")
        col2.metric("نسبة الثقة", "96.8%")
        col3.metric("مستوى الخطر", "عالي - تنبيه أحمر")
        
        st.warning("⚠️ التنبؤ بالمسار: التسرب يتجه نحو محطة التحلية خلال 6 ساعات بناءً على سرعة الرياح والتيارات البحرية.")
